# RAHASIA, hanya di server (Netlify > Site configuration > Environment variables). Jangan di-commit.
# Supabase > Project Settings > API > service_role. Dipakai route /m untuk mengambil isi materi
# dari bucket privat setelah akses diperiksa, dan oleh `npm run content:import`.
SUPABASE_SERVICE_ROLE_KEY=
# Kunci penanda tangan URL pembaca materi, minimal 32 karakter. Buat dengan: openssl rand -hex 32
MATERIAL_TOKEN_SECRET=

# Tautan konfirmasi email kembali ke <alamat situs>/auth/callback. Daftarkan alamat situs di
# Supabase > Authentication > URL Configuration (Site URL dan Redirect URLs).
