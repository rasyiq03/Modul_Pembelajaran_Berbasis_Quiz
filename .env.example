# URL dan Kunci Publik Supabase (didapat dari Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Kunci Rahasia Service Role (rahasia server, jangan pernah diekspos ke klien)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Rahasia Token Pembaca Materi (minimal 32 karakter, misal: openssl rand -hex 32)
MATERIAL_TOKEN_SECRET=your_material_token_secret_min_32_characters_here
